diff --git a/src/gui.c b/src/gui.c
index 0b389d7..038e182 100644
--- a/src/gui.c
+++ b/src/gui.c
@@ -47,0 +48,5 @@ static Colormap colormap;
+static int damage_available = -1;
+static int damage_event_base;
+
+static void prepareTile(WindowInfo *wi);
+static int placeSingleTile(int index);
@@ -192,0 +198,8 @@ static bool capturePreview(WindowInfo *wi)
+    if (damage_available < 0) {
+        int error_base;
+        damage_available = XDamageQueryExtension(dpy, &damage_event_base,
+                                                  &error_base);
+    }
+    if (damage_available)
+        wi->preview_damage = XDamageCreate(dpy, wi->id,
+                                           XDamageReportNonEmpty);
@@ -238,0 +252,4 @@ static void releasePreview(WindowInfo *wi)
+    if (wi->preview_damage) {
+        XDamageDestroy(dpy, wi->preview_damage);
+        wi->preview_damage = None;
+    }
@@ -248,0 +266,59 @@ static void releasePreview(WindowInfo *wi)
+bool uiHandleDamage(XEvent *event)
+{
+    int i;
+    XDamageNotifyEvent *damage;
+
+    if (!g.uiShowHasRun || !damage_available
+        || event->type != damage_event_base + XDamageNotify)
+        return false;
+    damage = (XDamageNotifyEvent *) event;
+    for (i = 0; i < g.maxNdx; i++) {
+        if (g.winlist[i].id == damage->drawable) {
+            g.winlist[i].preview_damaged = true;
+            if (damage->geometry.width != g.winlist[i].preview_w
+                || damage->geometry.height != g.winlist[i].preview_h) {
+                releasePreview(&g.winlist[i]);
+                capturePreview(&g.winlist[i]);
+            } else {
+                XDamageSubtract(dpy, g.winlist[i].preview_damage, None, None);
+            }
+            break;
+        }
+    }
+    return true;
+}
+
+void uiRefreshPreviews(void)
+{
+    static struct timespec last = {0, 0};
+    struct timespec now;
+    int i;
+    bool redrawn = false;
+    long elapsed;
+
+    if (!g.uiShowHasRun)
+        return;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    elapsed = (now.tv_sec - last.tv_sec) * 1000000000L
+        + now.tv_nsec - last.tv_nsec;
+    if (elapsed < 33333333L)
+        return;
+
+    for (i = 0; i < g.maxNdx; i++) {
+        if (!g.winlist[i].preview_damaged)
+            continue;
+        g.winlist[i].preview_damaged = false;
+        if (g.winlist[i].tile)
+            XFreePixmap(dpy, g.winlist[i].tile);
+        g.winlist[i].tile = None;
+        prepareTile(&g.winlist[i]);
+        placeSingleTile(i);
+        redrawn = true;
+    }
+    if (redrawn) {
+        framesRedraw();
+        XFlush(dpy);
+        last = now;
+    }
+}
+
