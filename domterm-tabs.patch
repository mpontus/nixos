diff --git a/hlib/commands.js b/hlib/commands.js
index 855768d..57a0974 100644
--- a/hlib/commands.js
+++ b/hlib/commands.js
@@ -99,0 +100,15 @@ cmd('new-window', // FIXME needed
+function selectTab(forwards) {
+    const layout = DomTerm._layout;
+    const item = layout?._numberToLayoutItem(DomTerm.focusedWindowNumber);
+    const stack = item?.parent;
+    if (stack?.type === 'stack') {
+        const tabs = stack.contentItems;
+        const step = forwards ? 1 : -1;
+        const index = (tabs.indexOf(item) + step + tabs.length) % tabs.length;
+        layout._selectLayoutPane(tabs[index], "keyboard");
+    }
+    return true;
+}
+cmd('select-tab-next', () => selectTab(true), {context: "parent"});
+cmd('select-tab-previous', () => selectTab(false), {context: "parent"});
+
