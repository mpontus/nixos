@@ -24,0 +26 @@ along with alttab.  If not, see <http://www.gnu.org/licenses/>.
+#include <stdint.h>
@@ -166,0 +169,80 @@ static int pointedTile(int x, int y)
+static bool capturePreview(WindowInfo *wi)
+{
+    static int composite_available = -1;
+    int event_base, error_base;
+    XWindowAttributes attr;
+
+    if (composite_available < 0)
+        composite_available = XCompositeQueryExtension(dpy, &event_base,
+                                                        &error_base);
+    if (!composite_available || !XGetWindowAttributes(dpy, wi->id, &attr)
+        || attr.map_state != IsViewable || attr.width < 1 || attr.height < 1)
+        return false;
+
+    XCompositeRedirectWindow(dpy, wi->id, CompositeRedirectAutomatic);
+    wi->preview_redirected = true;
+    wi->preview = XCompositeNameWindowPixmap(dpy, wi->id);
+    if (!wi->preview) {
+        XCompositeUnredirectWindow(dpy, wi->id, CompositeRedirectAutomatic);
+        wi->preview_redirected = false;
+        return false;
+    }
+    wi->preview_visual = attr.visual;
+    wi->preview_w = attr.width;
+    wi->preview_h = attr.height;
+    return true;
+}
+
+static bool drawPreview(WindowInfo *wi)
+{
+    XRenderPictFormat *src_format, *dst_format;
+    XTransform transform = {{{0}}};
+    Picture src, dst;
+    unsigned int w, h;
+    int x, y;
+
+    if (!wi->preview && !capturePreview(wi))
+        return false;
+    src_format = XRenderFindVisualFormat(dpy, wi->preview_visual);
+    dst_format = XRenderFindVisualFormat(dpy, DefaultVisual(dpy, scr));
+    if (!src_format || !dst_format)
+        return false;
+
+    if ((uint64_t) iconW * wi->preview_h <= (uint64_t) iconH * wi->preview_w) {
+        w = iconW;
+        h = wi->preview_h * iconW / wi->preview_w;
+    } else {
+        h = iconH;
+        w = wi->preview_w * iconH / wi->preview_h;
+    }
+    if (!w || !h)
+        return false;
+    x = (iconW - w) / 2;
+    y = (iconH - h) / 2;
+
+    src = XRenderCreatePicture(dpy, wi->preview, src_format, 0, NULL);
+    dst = XRenderCreatePicture(dpy, wi->tile, dst_format, 0, NULL);
+    transform.matrix[0][0] = ((XFixed) wi->preview_w << 16) / w;
+    transform.matrix[1][1] = ((XFixed) wi->preview_h << 16) / h;
+    transform.matrix[2][2] = XDoubleToFixed(1.0);
+    XRenderSetPictureTransform(dpy, src, &transform);
+    XRenderSetPictureFilter(dpy, src, FilterBilinear, NULL, 0);
+    XRenderComposite(dpy, PictOpOver, src, None, dst, 0, 0, 0, 0,
+                     x, y, w, h);
+    XRenderFreePicture(dpy, src);
+    XRenderFreePicture(dpy, dst);
+    return true;
+}
+
+static void releasePreview(WindowInfo *wi)
+{
+    if (wi->preview) {
+        XFreePixmap(dpy, wi->preview);
+        wi->preview = None;
+    }
+    if (wi->preview_redirected) {
+        XCompositeUnredirectWindow(dpy, wi->id, CompositeRedirectAutomatic);
+        wi->preview_redirected = false;
+    }
+}
+
