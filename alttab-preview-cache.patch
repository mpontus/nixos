+static PermanentWindowInfo *findPreviewCache(Window window)
+{
+    PermanentWindowInfo *cached;
+
+    DL_SEARCH_SCALAR(g.sortlist, cached, id, window);
+    return cached;
+}
+
+static void releaseCachedPreview(PermanentWindowInfo *cached)
+{
+    int i;
+
+    if (!cached || !cached->preview)
+        return;
+    if (g.winlist) {
+        for (i = 0; i < g.maxNdx; i++) {
+            if (g.winlist[i].id != cached->id || !g.winlist[i].preview_cached)
+                continue;
+            if (g.winlist[i].preview_damage)
+                XDamageDestroy(dpy, g.winlist[i].preview_damage);
+            g.winlist[i].preview_damage = None;
+            g.winlist[i].preview = None;
+            g.winlist[i].preview_redirected = false;
+            g.winlist[i].preview_cached = false;
+        }
+    }
+    XFreePixmap(dpy, cached->preview);
+    if (cached->preview_redirected)
+        XCompositeUnredirectWindow(dpy, cached->id,
+                                   CompositeRedirectAutomatic);
+    cached->preview = None;
+    cached->preview_redirected = false;
+}
+
+static void trimPreviewCache(Window keep)
+{
+    PermanentWindowInfo *cached;
+    int count = 0;
+
+    DL_FOREACH(g.sortlist, cached)
+        if (cached->preview)
+            count++;
+    if (count <= 32)
+        return;
+    for (cached = g.sortlist; cached && cached->next; cached = cached->next)
+        ;
+    for (; cached && count > 32; cached = cached->prev) {
+        if (cached->preview && cached->id != keep) {
+            releaseCachedPreview(cached);
+            count--;
+        }
+    }
+}
