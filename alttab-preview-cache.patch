+void uiCacheWindow(Window window)
+{
+    WindowInfo preview = {0};
+
+    if (!findPreviewCache(window))
+        return;
+    uiDropPreview(window);
+    preview.id = window;
+    if (capturePreview(&preview))
+        releasePreview(&preview);
+}
