diff --git a/src/win.c b/src/win.c
index 9825f20..890318c 100644
--- a/src/win.c
+++ b/src/win.c
@@ -28,0 +29 @@ along with alttab.  If not, see <http://www.gnu.org/licenses/>.
+#include <ctype.h>
@@ -192,0 +194,61 @@ size_t get_desktop_name(Window win, unsigned long desktop, char* name) {
+static void set_app_id(WindowInfo *wi)
+{
+    XClassHint hint = {0};
+    const char *source = NULL;
+
+    if (XGetClassHint(dpy, wi->id, &hint))
+        source = (hint.res_class && hint.res_class[0]) ? hint.res_class : hint.res_name;
+
+    if (source && source[0]) {
+        size_t i;
+        for (i = 0; source[i] && i < MAXNAMESZ - 1; i++)
+            wi->app_id[i] = tolower((unsigned char)source[i]);
+        wi->app_id[i] = '\0';
+    } else {
+        snprintf(wi->app_id, MAXNAMESZ, "window:%lx", wi->id);
+    }
+
+    if (hint.res_name)
+        XFree(hint.res_name);
+    if (hint.res_class)
+        XFree(hint.res_class);
+}
+
+static void filter_window_groups(void)
+{
+    int in, out = 0;
+    char current_app[MAXNAMESZ];
+
+    if (g.option_group == GROUP_WINDOWS || g.maxNdx == 0)
+        return;
+
+    strncpy(current_app, g.winlist[0].app_id, MAXNAMESZ);
+    current_app[MAXNAMESZ - 1] = '\0';
+
+    for (in = 0; in < g.maxNdx; in++) {
+        bool keep = true;
+        int seen;
+
+        if (g.option_group == GROUP_CURRENT) {
+            keep = strcmp(g.winlist[in].app_id, current_app) == 0;
+        } else {
+            for (seen = 0; seen < out; seen++) {
+                if (strcmp(g.winlist[seen].app_id, g.winlist[in].app_id) == 0) {
+                    keep = false;
+                    break;
+                }
+            }
+        }
+
+        if (!keep) {
+            if (g.winlist[in].icon_allocated)
+                XFreePixmap(dpy, g.winlist[in].icon_drawable);
+            continue;
+        }
+        if (out != in)
+            g.winlist[out] = g.winlist[in];
+        out++;
+    }
+    g.maxNdx = out;
+}
+
